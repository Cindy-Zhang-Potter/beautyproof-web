{
  "id": "evidence_matcher_claim_classification_1",
  "pluginKey": "@official-plugins/ai-categorization",
  "pluginVersion": "1.0.21",
  "name": "证据匹配声明分类",
  "description": "将原子Claim与官方证据包进行对照分类，判定为SUPPORTED / PARTIAL / CONTEXT_MISMATCH三类",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "claim_text": {
        "type": "string",
        "description": "待分类的原子Claim文本"
      },
      "evidence_package": {
        "type": "string",
        "description": "官方证据包文本内容"
      }
    },
    "required": [
      "claim_text",
      "evidence_package"
    ]
  },
  "formValue": {
    "textToBeCategorized": "{{input.claim_text}}",
    "categories": [
      {
        "name": "SUPPORTED"
      },
      {
        "name": "PARTIAL"
      },
      {
        "name": "CONTEXT_MISMATCH"
      }
    ],
    "customRequirements": "请将提供的原子Claim与官方证据包内容进行对照分析：\n1. SUPPORTED：Claim内容完全被官方证据包支持，所有关键信息均有明确依据\n2. PARTIAL：Claim部分内容被支持，部分信息与证据包不一致或缺乏足够依据\n3. CONTEXT_MISMATCH：Claim内容与证据包上下文完全不符，或核心信息存在根本性冲突\n\n官方证据包内容：{{input.evidence_package}}",
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    }
  },
  "createdAt": 1791218628929,
  "updatedAt": 1791218628929,
  "createdBy": 7580873613637586117
}